# stackql binary and server artifacts
stackql
stackql.exe
stackql-zip
stackql-server.log
nohup.out
*.log
/.stackql

# node
node_modules/

# python
__pycache__/
*.py[cod]
.venv/
venv/

# env / secrets
.env
.env.*
!.env.example

# IDE / editor
.vscode/
.idea/
*.swp

