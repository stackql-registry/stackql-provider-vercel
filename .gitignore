# stackql binary and server artifacts
stackql
stackql.exe
stackql-zip
stackql-server.log
nohup.out
*.log
/.stackql

# node
node_modules/

# python
__pycache__/
*.py[cod]
.venv/
venv/

# env / secrets
.env
.env.*
!.env.example

# IDE / editor
.vscode/
.idea/
*.swp

# docs site build output
website/build/
website/.docusaurus/
website/.shared-config/

# misc
.DS_Store
*.tmp
*.bak

# The Vercel OpenAPI document is large (~10 MB) and unversioned upstream;
# it is fetched by `make fetch-spec` and recorded by hash, version and
# operation counts in provider-dev/config/spec_pin.json (committed).
provider-dev/downloaded/*
!provider-dev/downloaded/.gitkeep

# transient analyze output merged into all_services.csv by `make mappings`
provider-dev/config/.analyze/

# split per-service specs are build artifacts, regenerated from the fetched spec by `make split`
provider-dev/source/*.yaml
